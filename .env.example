# ============================================================
# chAs Technologies LLC — Environment Variables
# ============================================================
# Copy these to your Vercel project Environment Variables.
# NEVER prefix secrets with VITE_ — those leak to the browser.
# DATABASE_URL is injected automatically by Vercel Postgres.
# ============================================================

# ── App ──────────────────────────────────────────────────────
# Your production domain (no trailing slash). Used for OG tags,
# payment callback URLs, and canonical links.
APP_URL=https://your-domain.example

# ── Vercel / Deployment ───────────────────────────────────────
# Set automatically by the platform after first deploy.
# Do NOT set this locally — its absence enables preview mode.
# GROK_PROJECT_ID=<set-by-platform>

# ── Database ─────────────────────────────────────────────────
# Injected by Vercel Postgres (or Neon) add-on. Set manually
# if using an external Postgres provider.
# DATABASE_URL=postgresql://...

# ── Paystack ─────────────────────────────────────────────────
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Flutterwave ──────────────────────────────────────────────
# Dashboard: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-...
# Webhook hash: set under Flutterwave → Settings → Webhooks
FLUTTERWAVE_WEBHOOK_HASH=

# ── Telegram ─────────────────────────────────────────────────
# Create a bot via @BotFather. Make it an admin in each classroom group.
TELEGRAM_BOT_TOKEN=

# JSON map of product slug → Telegram group/channel chat ID (negative number).
# Example: {"ai-music-generator":"-1001234567890","ai-video-generator":"-1009876543210"}
TELEGRAM_CLASS_CHATS=

# ── Webhook URLs (configure in payment dashboards) ───────────
# Paystack  → https://dashboard.paystack.com/#/settings/developer → Webhooks
#   Add: https://your-domain.example/api/payments/paystack/webhook
# Flutterwave → Settings → Webhooks
#   Add: https://your-domain.example/api/payments/flutterwave/webhook
